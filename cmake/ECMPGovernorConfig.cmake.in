@PACKAGE_INIT@

# ECMPGovernor 1.0.0 - deterministic equal-cost multipath governance runtime.
#
# Imported target provided by this package:
#   SummonSoftwareLabs::ECMPGovernor
#
# The target is a static library and carries its own include directories and its
# platform link dependencies, so a consumer only writes:
#
#   find_package(ECMPGovernor CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE SummonSoftwareLabs::ECMPGovernor)

include(CMakeFindDependencyMacro)
if(WIN32)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ECMPGovernorTargets.cmake")

set(ECMPGovernor_VERSION "@PROJECT_VERSION@")
set(ECMPGovernor_WIRE_VERSION 1)
set(ECMPGovernor_PERSISTENCE_VERSION 1)

check_required_components(ECMPGovernor)
